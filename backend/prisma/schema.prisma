// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // extensions = [vector]
}

// --------------------------------------
// 1. MULTI-TENANCY & AUTH
// --------------------------------------

enum OrganizationPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  LAWYER
  ASSISTANT
  STAFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Organization {
  id          String             @id @default(uuid())
  name        String             // Nombre legal o denominación
  tradeName   String?            // Nombre comercial
  cuit        String?            // Identificador fiscal
  status      OrganizationStatus @default(ACTIVE)
  plan        OrganizationPlan   @default(STARTER)
  settings    Json?              // Visual settings, notifications
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  users             User[]
  memberships       OrganizationMembership[]
  invitations       OrganizationInvitation[]
  activeSessions    UserSession[]            @relation("ActiveOrgSessions")
  auditLogs         AuditLog[]
  expedientes       Expediente[]
  expedientesPartes ExpedienteParte[]
  clients           Client[]
  documentos        Documento[]
  documentVersions  DocumentVersion[]
  documents         Document[]
  documentFileVersions DocumentFileVersion[]
  legalWritings     LegalWriting[]
  legalDraftVersions LegalDraftVersion[]
  legalDraftTemplates LegalDraftTemplate[]
  legalDraftReviews LegalDraftReview[]
  legalDraftExports LegalDraftExport[]
  legalAiConversations LegalAiConversation[]
  legalAiMessages   LegalAiMessage[]
  legalAiAnalyses   LegalAiAnalysis[]
  eventosAgenda     EventoAgenda[]
  movimientosProcesales MovimientoProcesal[]
  agendaEvents      AgendaEvent[]
  vencimientos      Vencimiento[]
  templates         LegalTemplate[]
  judicialAccounts  JudicialAccount[]
  usage             TenantUsage?
  aiInteractions    AIInteraction[]
  aiChatSessions    AIChatSession[]
  aiChatMessages    AIChatMessage[]
  legalDrafts       LegalDraft[]
  legalRiskAnalyses LegalRiskAnalysis[]
  eventLogs         EventLog[]
  employeeMetrics   EmployeeMetric[]

  @@index([status])
}

enum UserRole {
  ADMIN
  PARTNER      // Socio
  ASSOCIATE    // Asociado
  PARALEGAL
  CLIENT       // Vista limitada
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  fullName       String
  role           UserRole     @default(ASSOCIATE)
  permissions    Json?        // Granular overrides
  
  refreshTokenHash String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  identities          UserIdentity[]
  sessions            UserSession[]
  memberships         OrganizationMembership[]
  sentInvitations     OrganizationInvitation[] @relation("InvitedByUser")
  targetedInvitations OrganizationInvitation[] @relation("TargetInvitedUser")

  auditLogs      AuditLog[]
  assignedCases  Expediente[] // Case ownership/assignment
  responsableDeExpedientes Expediente[] @relation("ExpedienteResponsable")
  movimientosRegistrados   MovimientoProcesal[] @relation("MovimientoRegistradoPor")
  movimientosAnulados      MovimientoProcesal[] @relation("MovimientoAnuladoPor")
  agendaEventsResponsable  AgendaEvent[]        @relation("AgendaEventResponsable")
  agendaEventsCreados      AgendaEvent[]        @relation("AgendaEventCreador")
  vencimientosResponsable  Vencimiento[]        @relation("VencimientoResponsable")
  vencimientosCreados      Vencimiento[]        @relation("VencimientoCreador")
  vencimientosCumplidos    Vencimiento[]        @relation("VencimientoCumplidoPor")
  documentsCreated         Document[]           @relation("DocumentCreatedBy")
  documentsArchived        Document[]           @relation("DocumentArchivedBy")
  documentVersionsUploaded DocumentFileVersion[] @relation("DocumentVersionUploadedBy")
  legalWritingsCreated     LegalWriting[]       @relation("LegalWritingCreatedBy")
  legalWritingsArchived    LegalWriting[]       @relation("LegalWritingArchivedBy")
  legalDraftVersionsCreated LegalDraftVersion[] @relation("LegalDraftVersionCreatedBy")
  legalDraftTemplatesCreated LegalDraftTemplate[] @relation("LegalDraftTemplateCreatedBy")
  legalDraftTemplatesArchived LegalDraftTemplate[] @relation("LegalDraftTemplateArchivedBy")
  legalDraftReviewsAssigned LegalDraftReview[]  @relation("LegalDraftReviewer")
  legalDraftReviewsRequested LegalDraftReview[] @relation("LegalDraftReviewRequestedBy")
  legalDraftExportsGenerated LegalDraftExport[] @relation("LegalDraftExportGeneratedBy")
  legalAiConversations       LegalAiConversation[]
  legalAiAnalyses            LegalAiAnalysis[]
  aiChatSessions AIChatSession[]
  drafts         LegalDraft[]


  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model UserIdentity {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer       String    // e.g. "https://abogados-auth.us.auth0.com/"
  subject      String    // e.g. "auth0|64f123abc456..."
  provider     String    @default("auth0") // "auth0", "google-oauth2"
  authEmail    String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@unique([issuer, subject])
  @@index([userId])
}

model UserSession {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?       // Organización activa resuelta y validada en backend
  activeOrganization   Organization? @relation("ActiveOrgSessions", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  sessionToken         String        @unique // Hash SHA-256 de rawSessionSecret
  sessionVersion       Int           @default(1)
  auth0Sid             String?
  deviceInfo           String?
  ipAddress            String?
  expiresAt            DateTime      // Vencimiento absoluto (8 horas)
  idleExpiresAt        DateTime      // Vencimiento por inactividad (30 minutos)
  revokedAt            DateTime?     // Marca de revocación individual
  createdAt            DateTime      @default(now())
  lastActiveAt         DateTime      @default(now())

  @@index([userId])
  @@index([activeOrganizationId])
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  joinedAt       DateTime?
  suspendedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
}

model OrganizationInvitation {
  id               String           @id @default(uuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role             OrganizationRole
  tokenHash        String           @unique // Hash SHA-256 de token CSPRNG (nunca plaintext)
  invitedEmail     String           // Email normalizado en minúsculas
  targetUserId     String?
  targetUser       User?            @relation("TargetInvitedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  invitedById      String
  invitedBy        User             @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Restrict)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([expiresAt])
}

model OidcTransaction {
  transactionId String   @id // Identificador opaco de correlación
  state         String
  nonce         String
  codeVerifier  String   // Cifrado autenticado AES-256-GCM en reposo
  expiresAt     DateTime // TTL máx 10 minutos
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

// --------------------------------------
// 2. CORE LEGAL ENTITIES
// --------------------------------------

enum ExpedienteEstado {
  INICIO
  EN_TRAMITE
  PRUEBA
  ALEGATOS
  SENTENCIA
  APELACION
  PENDIENTE
  SUSPENDIDO
  FINALIZADO
  ARCHIVADO
}

enum RolParteProcesal {
  ACTOR
  DEMANDADO
  DENUNCIANTE
  DENUNCIADO
  QUERELLANTE
  IMPUTADO
  SOLICITANTE
  BENEFICIARIO
  TERCERO
  OTRO
}

model Expediente {
  id               String           @id @default(uuid())
  caratula         String
  numeroExpediente String
  juzgado          String
  jurisdiccion     String
  provincia        String?
  fuero            String?
  secretaria       String?
  tipoProceso      String?
  materia          String?
  fechaInicio      DateTime?
  descripcion      String?
  estado           ExpedienteEstado @default(EN_TRAMITE)
  tags             String[]
  
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  
  responsableId    String?
  responsable      User?            @relation("ExpedienteResponsable", fields: [responsableId], references: [id])
  users            User[]           // Abogados asignados
  partes           ExpedienteParte[]
  documentos       Documento[]
  documents        Document[]
  legalWritings    LegalWriting[]
  legalAiConversations LegalAiConversation[]
  legalAiAnalyses      LegalAiAnalysis[]
  eventos          EventoAgenda[]
  movimientos      MovimientoProcesal[]
  agendaEvents     AgendaEvent[]
  vencimientos     Vencimiento[]
  drafts           LegalDraft[]
  riskAnalyses     LegalRiskAnalysis[]
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId])
  @@index([organizationId, estado])
  @@index([organizationId, numeroExpediente])
}

model ExpedienteParte {
  id             String           @id @default(uuid())
  expedienteId   String
  expediente     Expediente       @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  clientId       String?
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tipoParte      ClientPersonType @default(HUMANA)
  nombre         String
  cuitDni        String?
  rol            RolParteProcesal @default(ACTOR)
  caracter       String?
  esCliente      Boolean          @default(false)
  observaciones  String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([expedienteId])
  @@index([organizationId])
  @@index([clientId])
}

enum DocumentoTipo {
  ESCRITO
  CEDULA
  SENTENCIA
  PRUEBA_DOCUMENTAL
  OTRO
}

model Documento {
  id             String        @id @default(uuid())
  expedienteId   String
  expediente     Expediente    @relation(fields: [expedienteId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  
  tipo           DocumentoTipo
  storagePath    String
  fileName       String
  fileSize       Int
  mimeType       String
  
  // Security & Forensics
  hashSha256     String        // For integrity check
  isLocked       Boolean       @default(false) // WORM support
  lockExpiresAt  DateTime?
  legalHold      Boolean       @default(false) // Litigation Hold (indefinite)
  legalHoldReason String?
  
  
  // Content
  ocrContent     String?       @db.Text
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  versions       DocumentVersion[]

  @@index([organizationId])
}

// --------------------------------------
// 2b. AUTH-08: DOCUMENT MANAGEMENT (LOGICAL DOCUMENTS + IMMUTABLE VERSIONS)
// --------------------------------------

enum DocumentCategory {
  DEMANDA
  CONTESTACION
  ESCRITO_JUDICIAL
  RESOLUCION
  SENTENCIA
  NOTIFICACION
  PODER
  CONTRATO
  DOCUMENTACION_CLIENTE
  PRUEBA_DOCUMENTAL
  INFORME
  DICTAMEN
  COMPROBANTE
  CORRESPONDENCIA
  OTRO
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model Document {
  id                    String               @id @default(uuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  expedienteId          String?
  expediente            Expediente?          @relation(fields: [expedienteId], references: [id], onDelete: SetNull)
  clientId              String?
  client                Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  movimientoProcesalId  String?
  movimientoProcesal    MovimientoProcesal?  @relation(fields: [movimientoProcesalId], references: [id], onDelete: SetNull)

  title                 String
  description           String?
  category              DocumentCategory     @default(OTRO)
  documentDate          DateTime?
  status                DocumentStatus       @default(ACTIVE)
  currentVersionNumber  Int                  @default(0)

  createdById           String
  createdBy             User                 @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt            DateTime?
  archivedById          String?
  archivedBy            User?                @relation("DocumentArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  versions              DocumentFileVersion[]
  legalDraftExports     LegalDraftExport[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, expedienteId])
  @@index([organizationId, clientId])
  @@index([organizationId, movimientoProcesalId])
}

model DocumentFileVersion {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentId       String
  document         Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber    Int
  originalFilename String
  storageKey       String       @unique
  mimeType         String
  sizeBytes        Int
  sha256           String

  uploadedById     String
  uploadedBy       User         @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt       DateTime     @default(now())
  changeNote       String?

  @@unique([documentId, versionNumber])
  @@index([organizationId])
  @@index([organizationId, documentId])
}

// --------------------------------------
// 2c. AUTH-09: LEGAL DRAFTING, VERSIONS, TEMPLATES, REVIEWS & EXPORTS
// --------------------------------------

enum LegalDraftCategory {
  ESCRITO_JUDICIAL
  CONTRATO
}

enum LegalDraftDocumentType {
  DEMANDA
  CONTESTACION_DEMANDA
  CONTESTACION_TRASLADO
  EXCEPCION
  APERTURA_PRUEBA
  ALEGATO
  APELACION
  RECURSO
  EXPRESION_AGRAVIOS
  CONTESTACION_AGRAVIOS
  PRONTO_DESPACHO
  MEDIDA_CAUTELAR
  ESCRITO_LIBRE
  SOLICITUD
  OFICIO
  PRESENTACION_SIMPLE
  INCIDENTE
  CONTRATO_LOCACION
  CONTRATO_SERVICIOS
  CONTRATO_NDA
  CONTRATO_COMPRAVENTA
  CONTRATO_MUTUO
  OTRO_CONTRATO
  OTRO
}

enum LegalDraftStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  FINALIZED
  ARCHIVED
}

enum LegalContentFormat {
  TIPTAP_JSON
}

enum LegalDraftReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum LegalDraftExportFormat {
  DOCX
  PDF
}

enum LegalDraftExportStatus {
  COMPLETED
  FAILED
}

model LegalDraftTemplate {
  id               String                 @id @default(uuid())
  organizationId   String?
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name             String
  description      String?
  category         LegalDraftCategory     @default(ESCRITO_JUDICIAL)
  documentType     LegalDraftDocumentType @default(OTRO)
  versionNumber    Int                    @default(1)
  baseInstructions String?                @db.Text
  variables        Json                   @default("[]")
  requiredInfo     Json                   @default("[]")
  jurisdiction     String?
  fuero            String?
  content          Json
  contentFormat    LegalContentFormat     @default(TIPTAP_JSON)
  isSystemTemplate Boolean                @default(false)
  isActive         Boolean                @default(true)

  createdById      String?
  createdBy        User?                  @relation("LegalDraftTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt       DateTime?
  archivedById     String?
  archivedBy       User?                  @relation("LegalDraftTemplateArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  derivedWritings  LegalWriting[]

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([isSystemTemplate, isActive])
  @@index([documentType])
  @@index([category])
}

model LegalWriting {
  id                   String                 @id @default(uuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  expedienteId         String?
  expediente           Expediente?            @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  clientId             String?
  client               Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourceTemplateId     String?
  sourceTemplate       LegalDraftTemplate?    @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  title                String
  category             LegalDraftCategory     @default(ESCRITO_JUDICIAL)
  documentType         LegalDraftDocumentType @default(OTRO)
  jurisdiction         String?
  courtName            String?
  caseNumber           String?
  status               LegalDraftStatus       @default(DRAFT)
  currentVersionNumber Int                    @default(1)
  isAiGenerated        Boolean                @default(false)
  aiMetadata           Json?

  createdById          String
  createdBy            User                   @relation("LegalWritingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt           DateTime?
  archivedById         String?
  archivedBy           User?                  @relation("LegalWritingArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  versions             LegalDraftVersion[]
  reviews              LegalDraftReview[]
  exports              LegalDraftExport[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, expedienteId])
  @@index([organizationId, documentType])
  @@index([organizationId, category])
  @@index([organizationId, createdById])
}

model LegalDraftVersion {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalDraftId   String
  legalDraft     LegalWriting       @relation(fields: [legalDraftId], references: [id], onDelete: Cascade)

  versionNumber  Int
  content        Json
  contentFormat  LegalContentFormat @default(TIPTAP_JSON)
  plainText      String             @db.Text
  changeNote     String?
  generatedByAi  Boolean            @default(false)
  aiMetadata     Json?

  createdById    String
  createdBy      User               @relation("LegalDraftVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())

  reviews        LegalDraftReview[]
  exports        LegalDraftExport[]

  @@unique([legalDraftId, versionNumber])
  @@index([organizationId])
  @@index([organizationId, legalDraftId])
}

model LegalDraftReview {
  id            String                 @id @default(uuid())
  organizationId String
  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalDraftId  String
  legalDraft    LegalWriting           @relation(fields: [legalDraftId], references: [id], onDelete: Cascade)
  versionId     String
  version       LegalDraftVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User                   @relation("LegalDraftReviewRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewerId    String?
  reviewer      User?                  @relation("LegalDraftReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  status        LegalDraftReviewStatus @default(PENDING)
  comments      String?                @db.Text
  requestedAt   DateTime               @default(now())
  reviewedAt    DateTime?

  @@index([organizationId])
  @@index([organizationId, legalDraftId])
  @@index([organizationId, versionId])
}

model LegalDraftExport {
  id                String                 @id @default(uuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalDraftId      String
  legalDraft        LegalWriting           @relation(fields: [legalDraftId], references: [id], onDelete: Cascade)
  versionId         String
  version           LegalDraftVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)

  format            LegalDraftExportFormat
  storageDocumentId String
  storageDocument   Document               @relation(fields: [storageDocumentId], references: [id], onDelete: Restrict)

  generatedById     String
  generatedBy       User                   @relation("LegalDraftExportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  generatedAt       DateTime               @default(now())
  sha256            String
  status            LegalDraftExportStatus @default(COMPLETED)
  idempotencyKey    String?
  optionsHash       String
  exportOptions     Json?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, legalDraftId])
  @@index([organizationId, versionId, format, optionsHash])
}

// --------------------------------------
// 2d. AUTH-10: CONTEXTUAL LEGAL AI ASSISTANT CONVERSATIONS
// --------------------------------------

enum LegalAiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum LegalAiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum LegalAiMessageStatus {
  COMPLETED
  FAILED
}

model LegalAiConversation {
  id             String                    @id @default(uuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  expedienteId   String?
  expediente     Expediente?               @relation(fields: [expedienteId], references: [id], onDelete: SetNull)

  title          String
  status         LegalAiConversationStatus @default(ACTIVE)
  lastMessageAt  DateTime?
  archivedAt     DateTime?

  messages       LegalAiMessage[]

  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId])
  @@index([organizationId, userId, status])
  @@index([organizationId, expedienteId])
  @@index([organizationId, userId, lastMessageAt])
}

model LegalAiMessage {
  id                String               @id @default(uuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversationId    String
  conversation      LegalAiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role              LegalAiMessageRole
  content           String               @db.Text
  messageStatus     LegalAiMessageStatus @default(COMPLETED)
  clientMessageId   String?
  contextReferences Json?
  providerMetadata  Json?

  createdAt         DateTime             @default(now())

  @@unique([conversationId, clientMessageId])
  @@index([organizationId])
  @@index([organizationId, conversationId, createdAt])
}

// --------------------------------------
// 2e. AUTH-11: LEGAL AI CASE & DOCUMENT ANALYSIS
// --------------------------------------

enum LegalAiAnalysisType {
  INTEGRAL_CASE
  FACTS_AND_CONTROVERSIES
  DOCUMENTARY_EVIDENCE
  PROCEDURAL_RISKS
}

enum LegalAiAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

model LegalAiAnalysis {
  id                String                @id @default(uuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  expedienteId      String?
  expediente        Expediente?           @relation(fields: [expedienteId], references: [id], onDelete: SetNull)

  analysisType      LegalAiAnalysisType
  title             String
  status            LegalAiAnalysisStatus @default(PENDING)
  inputInstructions String?               @db.Text

  resultContent     Json?
  editedContent     Json?
  editedAt          DateTime?
  sourceReferences  Json?
  providerMetadata  Json?
  archivedAt        DateTime?

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([organizationId])
  @@index([organizationId, userId, status])
  @@index([organizationId, expedienteId, createdAt])
  @@index([organizationId, analysisType])
}

