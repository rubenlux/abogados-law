// --------------------------------------
// 15. TELEMETRY & LEGAL PIXEL (Big Data)
// --------------------------------------

enum ActorType {
  USER
  EMPLOYEE
  CLIENT
  SYSTEM
  BOT
}

enum EventCategory {
  SECURITY
  LEGAL
  IA
  FINANCIAL
  HR
  SYSTEM
  CLIENT
}

enum EventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model EventLog {
  id             String      @id @default(uuid())
  correlationId  String?     // UUID grouping ops
  requestId      String?
  parentEventId  String?
  
  category       EventCategory @default(SYSTEM)
  severity       EventSeverity @default(INFO)
  
  timestamp      DateTime    @default(now())
  
  actorType      ActorType
  actorId        String?
  
  eventType      String
  entityType     String?
  entityId       String?
  
  payload        Json?
  
  ipAddress      String?
  userAgent      String?
  deviceFingerprint String?
  sessionId      String?
  
  // -- FORENSIC SECURITY --
  prevHash       String?
  currentHash    String?     // SHA-256
  signature      String?     // HMAC
  
  riskScore      Int         @default(0)
  isAnomaly      Boolean     @default(false)
  
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  
  @@index([timestamp])
  @@index([actorId])
  @@index([currentHash])     // Integrity check
  @@index([organizationId])
}

// --------------------------------------
// 16. OFFICE & EMPLOYEE METRICS
// --------------------------------------

model EmployeeMetric {
  id                String        @id @default(uuid())
  userId            String
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  date              DateTime      @db.Date
  
  activeTimeMinutes Int           @default(0)
  ticketsResolved   Int           @default(0)
  aiPromptsUsed     Int           @default(0)
  documentsRead     Int           @default(0)
  
  productivityScore Int           @default(0) // 0-100
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@unique([userId, date])
  @@index([organizationId])
}
